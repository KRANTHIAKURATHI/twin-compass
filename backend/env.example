# Copy this file to `.env` before running the backend.
#
# SQLite by default. To connect Supabase, set your project's Postgres
# connection string, e.g.:
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=sqlite:///./onco_twin.db

# Used to sign JWT access tokens. Generate a real secret for production, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated list of origins allowed to call this API (your frontend URL).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

ENVIRONMENT=development
