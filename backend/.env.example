# ===========================================================================
# Copy to .env. Never commit the real .env.
#
# The backend runs in one of two modes, selected by AUTH_PROVIDER.
# The default below (local) needs nothing installed beyond pip packages.
# ===========================================================================

ENVIRONMENT=local            # local | dev | staging | prod
APP_NAME=OncoTwin API

# ---------------------------------------------------------------------------
# MODE 1 - FILE MODE (default). No Supabase, no Postgres, no network.
#   Identities, credentials (bcrypt) and tokens live in this backend.
#   The database is a SQLite file under DATA_DIR, created on first boot.
#   Password-reset links are appended to DATA_DIR/password-reset-links.log
#   instead of being emailed.
# ---------------------------------------------------------------------------
AUTH_PROVIDER=local
DATA_DIR=./data
# Leave DATABASE_URL empty to use DATA_DIR/oncotwin.db.
DATABASE_URL=
# Optional. If unset, a random secret is generated per process, which is fine
# for dev but signs everyone out on restart. Required in staging/prod.
# LOCAL_JWT_SECRET=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# MODE 2 - SUPABASE. Comment out the block above and use this instead.
#   Supabase Auth is the identity provider; profiles/user_roles live in the
#   same Postgres database. Run `alembic upgrade head` before first start.
#
#   Local Supabase: `supabase start`, then `supabase status` prints these.
#   Hosted: Dashboard -> Project Settings -> API, and use the PgBouncer
#   pooler connection string (port 6543, transaction mode) for DATABASE_URL.
# ---------------------------------------------------------------------------
# AUTH_PROVIDER=supabase
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=<anon key>
# SUPABASE_SERVICE_ROLE_KEY=<service role key>   # secret: bypasses RLS
# SUPABASE_JWT_SECRET=<jwt secret>
# SUPABASE_JWT_AUDIENCE=authenticated
# DATABASE_URL=postgresql+asyncpg://postgres:<password>@<host>:6543/postgres

# --- CORS: the frontend dev-server origins ---------------------------------
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8080"]

# --- Cookies ----------------------------------------------------------------
REFRESH_COOKIE_NAME=oncotwin_refresh_token
REFRESH_COOKIE_SECURE=false      # must be true in production (HTTPS only)
REFRESH_COOKIE_SAMESITE=lax

# --- Password policy (applied identically by register and reset-password) ---
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_LETTER=true

# --- Password reset ---------------------------------------------------------
PASSWORD_RESET_REDIRECT_URL=http://localhost:5173/reset-password

# --- Rate limiting ----------------------------------------------------------
AUTH_RATE_LIMIT=10/minute
RATE_LIMIT_ENABLED=true

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true
